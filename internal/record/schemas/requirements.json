{
  "$id": "requirements.json",
  "description": "A requirements version. Request is the count of requests read to produce it (request/1 through request/<request>).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "$ref": "common.json#/$defs/version"
    },
    "request": {
      "$ref": "common.json#/$defs/version"
    },
    "run_id": {
      "$ref": "common.json#/$defs/run_id"
    },
    "recorded_at": {
      "$ref": "common.json#/$defs/at"
    },
    "goal": {
      "$ref": "common.json#/$defs/text"
    },
    "completion_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/text"
          },
          "text": {
            "$ref": "common.json#/$defs/text"
          }
        },
        "required": [
          "id",
          "text"
        ]
      }
    },
    "constraints": {
      "$ref": "common.json#/$defs/texts"
    },
    "open_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/text"
          },
          "text": {
            "$ref": "common.json#/$defs/text"
          }
        },
        "required": [
          "id",
          "text"
        ]
      }
    }
  },
  "required": [
    "version",
    "request",
    "run_id",
    "recorded_at",
    "goal",
    "completion_conditions",
    "constraints",
    "open_points"
  ]
}
