{
  "$id": "request.json",
  "description": "The verbatim request. Append one for each additional request. The first request fixes the criteria commit for all later requests. An empty owner_words request fixes criteria when another workflow runs first.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owner_words": {
      "type": "string"
    },
    "supplement": {
      "type": "string"
    },
    "criteria_commit": {
      "$ref": "common.json#/$defs/sha"
    },
    "run_id": {
      "$ref": "common.json#/$defs/run_id"
    },
    "recorded_at": {
      "$ref": "common.json#/$defs/at"
    },
    "issue": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "owner_words",
    "supplement",
    "criteria_commit",
    "run_id",
    "recorded_at"
  ]
}
