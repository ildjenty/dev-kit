{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Instruction",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "work",
        "judgment_wait",
        "judgment",
        "plan_check",
        "detection_test",
        "plan",
        "question",
        "external",
        "completed",
        "aborted"
      ]
    },
    "target_key": {
      "type": "string"
    },
    "reissue": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string"
    },
    "brief": {
      "type": "string",
      "minLength": 1
    },
    "target_path": {
      "type": "string",
      "minLength": 1
    },
    "runner": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "$ref": "#/$defs/question"
    },
    "external": {
      "$ref": "#/$defs/external_operation_target"
    }
  },
  "required": [
    "id",
    "kind",
    "target_key",
    "reissue"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "work",
              "plan"
            ]
          }
        }
      },
      "then": {
        "required": [
          "brief"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "judgment",
              "plan_check",
              "detection_test"
            ]
          }
        }
      },
      "then": {
        "required": [
          "brief",
          "target_path"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "question"
          }
        }
      },
      "then": {
        "required": [
          "question"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "external"
          }
        }
      },
      "then": {
        "required": [
          "external"
        ]
      }
    }
  ],
  "$defs": {
    "question": {
      "$ref": "urn:devkit:form:question"
    },
    "external_operation_target": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "input_hash": {
          "type": "string",
          "minLength": 1
        },
        "definition_hash": {
          "type": "string",
          "minLength": 1
        },
        "executable_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "operation_id",
        "kind",
        "target",
        "input_hash",
        "definition_hash",
        "executable_hash"
      ],
      "additionalProperties": false
    }
  }
}
