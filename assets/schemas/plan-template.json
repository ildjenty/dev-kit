{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "start_stage": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/template-stage"
      }
    },
    "optional_stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/template-stage"
      }
    },
    "plan_limits": {
      "type": "object",
      "properties": {
        "max_rounds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_rounds"
      ],
      "additionalProperties": false
    },
    "planner_inputs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/selection"
      }
    },
    "judge_inputs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/selection"
      }
    }
  },
  "required": [
    "name",
    "start_stage",
    "stages",
    "optional_stages"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devkit.invalid/schemas/v1/plan-template.json",
  "$defs": {
    "template-stage": {
      "allOf": [
        {
          "$ref": "#/$defs/stage"
        },
        {
          "properties": {
            "checks": {
              "items": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "completion_condition_ids"
                      ]
                    },
                    {
                      "required": [
                        "target"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "not": {
            "required": [
              "units"
            ]
          }
        }
      ]
    },
    "stage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "replan"
          }
        },
        "assignee": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "gate": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "required",
            "reason"
          ],
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_rounds": {
              "type": "integer",
              "minimum": 1
            },
            "max_no_progress": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "max_rounds",
            "max_no_progress"
          ],
          "additionalProperties": false
        },
        "transitions": {
          "type": "object",
          "properties": {
            "fix": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "when": {
                        "type": "object",
                        "properties": {
                          "check": {
                            "type": "string",
                            "minLength": 1
                          },
                          "failures_at_least": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "human_rejected": {
                            "type": "boolean"
                          }
                        },
                        "additionalProperties": false
                      },
                      "assignee": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "assignee"
                    ],
                    "additionalProperties": false
                  }
                }
              ]
            },
            "ask": {
              "type": "string",
              "minLength": 1
            },
            "back": {
              "type": "string",
              "minLength": 1
            },
            "done": {
              "description": "A stage ID to continue, null to finish, or replan to have the planner rebuild the remaining plan after this stage completes.",
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "required": [
            "fix",
            "ask",
            "back",
            "done"
          ],
          "additionalProperties": false
        },
        "split": {
          "type": "boolean"
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "description",
              "scope"
            ],
            "additionalProperties": false
          }
        },
        "inputs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/selection"
          }
        }
      },
      "required": [
        "id",
        "assignee",
        "checks",
        "gate",
        "limits",
        "transitions"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "aspect": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "completion_condition_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selection"
          }
        },
        "examples": {
          "$ref": "#/$defs/selection"
        }
      },
      "required": [
        "aspect",
        "runner",
        "required"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "select": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "select"
      ],
      "additionalProperties": false
    }
  }
}
