{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question",
  "$ref": "#/$defs/question",
  "$defs": {
    "question": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "approval_target": {
          "$ref": "#/$defs/approval_target"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommendation": {
          "type": "string"
        },
        "recommendation_reason": {
          "type": "string"
        },
        "stop_category": {
          "type": "string",
          "minLength": 1
        },
        "next_stage": {
          "type": "string"
        },
        "stopped_stage": {
          "type": "string"
        },
        "stop_reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "screen_id": {
          "type": "string",
          "minLength": 1
        },
        "stop_observation": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "id",
        "text",
        "approval_target",
        "options",
        "recommendation",
        "stop_category",
        "next_stage",
        "stopped_stage",
        "stop_reason",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "approval_target": {
                "properties": {
                  "kind": {
                    "const": "decision"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "type": "array",
                "items": {
                  "enum": [
                    "approve",
                    "reject",
                    "defer"
                  ]
                },
                "uniqueItems": true,
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        }
      ]
    },
    "approval_target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "tree"
            },
            "tree": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "tree"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "plan"
            },
            "plan": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "plan"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "external"
            },
            "external": {
              "$ref": "#/$defs/external_operation_target"
            }
          },
          "required": [
            "kind",
            "external"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "decision"
            },
            "decision_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "decision_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "work"
            },
            "work_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "work_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "external_operation_target": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "input_hash": {
          "type": "string",
          "minLength": 1
        },
        "definition_hash": {
          "type": "string",
          "minLength": 1
        },
        "executable_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "operation_id",
        "kind",
        "target",
        "input_hash",
        "definition_hash",
        "executable_hash"
      ],
      "additionalProperties": false
    },
    "reference": {
      "$ref": "urn:devkit:form:reference"
    }
  },
  "$id": "urn:devkit:form:question"
}
