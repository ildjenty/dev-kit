{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding",
  "$ref": "#/$defs/finding",
  "$defs": {
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "auto-fixable",
            "needs-decision"
          ]
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "exemption": {
          "$ref": "#/$defs/exemption"
        },
        "resolved_finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "premise_broken": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "blocking",
        "kind",
        "scenario"
      ],
      "additionalProperties": false
    },
    "exemption": {
      "type": "object",
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "required": [
        "claim",
        "evidence"
      ],
      "additionalProperties": false
    },
    "reference": {
      "$ref": "urn:devkit:form:reference"
    }
  },
  "$id": "urn:devkit:form:finding"
}
