{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Termination block",
  "description": "A session worker submits this block with devkit submit; a devkit-worker returns it as a JSON-only final message collected by SubagentStop for its unit instruction.",
  "type": "object",
  "properties": {
    "instruction_id": {
      "type": "string",
      "minLength": 1
    },
    "termination_kind": {
      "enum": [
        "completion-claimed",
        "confirmation-required",
        "work-stopped"
      ]
    },
    "work_performed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confirmed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unconfirmed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resume_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "temporary_state": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/temporary_state"
      }
    },
    "change_reason": {
      "type": "string"
    },
    "report": {
      "description": "Stage or unit report. The selected report schema is required only for a completion claim; partial reports are allowed when asking or stopping. Schema conformance is not proof of completion.",
      "type": "object",
      "additionalProperties": true
    },
    "confirmation": {
      "$ref": "#/$defs/confirmation"
    },
    "notes": {
      "description": "Optional worker ledger notes, validated and recorded when accepting a SubagentStop result.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "decision",
              "evidence",
              "lesson"
            ]
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "kind",
          "payload"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "decision"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "urn:devkit:form:decision"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "evidence"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "urn:devkit:form:evidence"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "lesson"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "$ref": "urn:devkit:form:reference"
                      }
                    }
                  },
                  "required": [
                    "content",
                    "evidence"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      }
    },
    "commit_message": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "instruction_id",
    "termination_kind"
  ],
  "$defs": {
    "temporary_state": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1
        },
        "verification_method": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "invalid_when": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "content",
        "verification_method",
        "source",
        "invalid_when"
      ],
      "additionalProperties": false
    },
    "confirmation": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommendation": {
          "type": "string"
        },
        "recommendation_reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "urn:devkit:form:reference"
          }
        }
      },
      "required": [
        "text",
        "options",
        "recommendation",
        "recommendation_reason",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "recommendation": {
                "minLength": 1
              }
            },
            "required": [
              "recommendation"
            ]
          },
          "then": {
            "properties": {
              "recommendation_reason": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "termination_kind": {
            "const": "confirmation-required"
          }
        },
        "required": [
          "termination_kind"
        ]
      },
      "then": {
        "required": [
          "confirmation"
        ]
      }
    }
  ]
}
