{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Detection result",
  "type": "object",
  "properties": {
    "instruction_id": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "judgment": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT ASSESSED"
            ]
          },
          "blocking": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scenario": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "scenario"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "judgment",
          "blocking",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "instruction_id",
    "observations"
  ],
  "additionalProperties": false
}
