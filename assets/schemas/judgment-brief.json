{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pre-judgment planner result",
  "type": "object",
  "properties": {
    "instruction_id": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "instruction_id",
    "instructions"
  ],
  "additionalProperties": false
}
