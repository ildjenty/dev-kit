{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design report",
  "description": "Worker-reported material, not independent evidence of completion.",
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "description": "List human decisions first, followed by delegated decisions. Empty question and answer IDs mean no human answer is recorded. A decision approved at the scope or architecture gate cites that gate's question ID.",
      "items": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommendation": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "human",
              "delegated"
            ]
          },
          "decider": {
            "type": "string",
            "minLength": 1
          },
          "question_id": {
            "type": "string"
          },
          "answer_id": {
            "type": "string"
          },
          "cost_and_operational_effects": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "decision",
          "options",
          "recommendation",
          "reason",
          "classification",
          "decider",
          "question_id",
          "answer_id",
          "cost_and_operational_effects"
        ],
        "additionalProperties": false
      }
    },
    "design_reference": {
      "type": "string",
      "minLength": 1
    },
    "structure_reference": {
      "type": "string",
      "minLength": 1
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data_formats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failure_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "irreversible_contracts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unverified_matters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "decisions",
    "design_reference",
    "structure_reference",
    "interfaces",
    "data_formats",
    "failure_types",
    "irreversible_contracts",
    "unverified_matters"
  ],
  "additionalProperties": false
}
