{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Increments report",
  "description": "Worker-reported material, not independent evidence of completion.",
  "type": "object",
  "properties": {
    "increments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "completion_condition_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "size_grounds": {
            "type": "string",
            "minLength": 1
          },
          "verification_method": {
            "type": "string",
            "minLength": 1
          },
          "completion_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "purpose",
          "completion_condition_ids",
          "scope",
          "size_grounds",
          "verification_method",
          "completion_conditions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "increments"
  ],
  "additionalProperties": false
}
