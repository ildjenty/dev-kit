{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification report",
  "description": "Worker-reported material, not independent evidence of completion.",
  "type": "object",
  "properties": {
    "completion_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observed_result": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "scenario",
          "steps",
          "observed_result"
        ],
        "additionalProperties": false
      }
    },
    "unconfirmed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "completion_conditions",
    "unconfirmed"
  ],
  "additionalProperties": false
}
