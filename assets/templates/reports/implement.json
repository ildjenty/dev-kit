{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implement report",
  "description": "Worker-reported material, not independent evidence of completion.",
  "type": "object",
  "properties": {
    "completion_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification_results": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "tests",
          "verification_results"
        ],
        "additionalProperties": false
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "completion_conditions",
    "changes"
  ],
  "additionalProperties": false
}
