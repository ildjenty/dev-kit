{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structure report",
  "description": "Worker-reported material, not independent evidence of completion.",
  "type": "object",
  "properties": {
    "structure_reference": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "responsibility",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "existing_locations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rejected_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proposal": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "proposal",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "unverified_premises": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recovery_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "structure_reference",
    "modules",
    "dependencies",
    "existing_locations",
    "rejected_alternatives",
    "unverified_premises",
    "recovery_methods"
  ],
  "additionalProperties": false
}
