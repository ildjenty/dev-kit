{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handoff report",
  "description": "Worker-reported material, not independent evidence of completion.",
  "type": "object",
  "properties": {
    "description_path": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "heading",
          "summary"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "description_path",
    "sections"
  ],
  "additionalProperties": false
}
