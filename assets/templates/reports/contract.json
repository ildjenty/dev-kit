{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract report",
  "description": "Worker-reported material, not independent evidence of completion.",
  "type": "object",
  "properties": {
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data_formats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failure_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "irreversible_contracts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unverified_matters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "interfaces",
    "data_formats",
    "failure_types",
    "irreversible_contracts",
    "unverified_matters"
  ],
  "additionalProperties": false
}
